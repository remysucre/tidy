  43:src/main.c    ****         if (node->type == LXB_DOM_NODE_TYPE_ELEMENT) {
  44:src/main.c    ****             (*count)++;
  45:src/main.c    ****         }
  46:src/main.c    **** 
  47:src/main.c    ****         if (node->first_child != NULL) {
  48:src/main.c    ****             walk_tree(node->first_child, count);
  49:src/main.c    ****         }
  50:src/main.c    **** 
  51:src/main.c    ****         node = node->next;
  52:src/main.c    ****     }
  53:src/main.c    **** }
